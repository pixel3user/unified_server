# Required for PersonaPlex model download/license.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOICE_PROMPT_DIR=/opt/personaplex/custom_voices
CLOUDFLARE_TURN_TOKEN_ID=your_cloudflare_turn_token_id
CLOUDFLARE_TURN_API_TOKEN=your_cloudflare_turn_api_token
# Optional: override credential TTL in seconds. Default is 86400.
# CLOUDFLARE_TURN_TTL_SECONDS=86400

# Optional build-time custom PersonaPlex voice vendoring.
# Export these before running build_onebox.improved.sh, or source this file first.
# CUSTOM_VOICE_URL=https://firebasestorage.googleapis.com/...
# CUSTOM_VOICE_FILENAME=myvoice.pt

# MuseTalk runtime
MUSE_AVATAR_ID=my_avatar_720_live
MUSE_USE_FP16=1
MUSE_REQUIRE_MMPOSE=1
MUSE_PERSONAPLEX_PATH=/api/chat
MUSE_PERSONAPLEX_VOICE_PROMPT=myvoice.pt

# Public URL / TLS
ONEBOX_PUBLIC_HOST=YOUR_PUBLIC_HOST_OR_DOMAIN
ONEBOX_NGINX_ENABLE=1
ONEBOX_LETSENCRYPT_ENABLE=1
LETSENCRYPT_EMAIL=you@example.com
ONEBOX_TLS_ENABLE=0

# Auto bootstrap on fresh machine (downloads models + restores avatar tar)
AUTO_DOWNLOAD_WEIGHTS=1
RESULTS_RESTORE=1

# TURN mode
# Set TURN_PROVIDER=local for the built-in coturn server.
# Set TURN_PROVIDER=cloudflare to use Cloudflare-managed TURN credentials from /config.
# Set TURN_PROVIDER=off to disable managed TURN wiring entirely and rely on explicit ICE_SERVER values.
TURN_PROVIDER=cloudflare

# TURN
# If you use Cloudflare TURN, keep ENABLE_TURN=0 so local coturn does not start.
ENABLE_TURN=0
TURN_USER=avatar
TURN_PASS=change_me
TURN_REALM=musetalk.local
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_ENV_FILE=/opt/onebox/turn-native/turn_credentials.env

# Public host name or IP visible to browser for TURN candidate.
TURN_PUBLIC_HOST=YOUR_PUBLIC_HOST_OR_DOMAIN

# Optional external IP hint for coturn (sometimes needed under NAT)
# TURN_EXTERNAL_IP=YOUR_PUBLIC_IP

# Optional explicit ICE override (if set, these are passed as-is).
# Leave these unset when Cloudflare TURN or local coturn auto-wiring is enabled.
# ICE_SERVER=turn:YOUR_PUBLIC_HOST_OR_DOMAIN:3478?transport=tcp
# ICE_SERVER_2=turn:YOUR_PUBLIC_HOST_OR_DOMAIN:3478?transport=udp
# ICE_SERVER_3=turns:turn.cloudflare.com:5349?transport=tcp
# ICE_TRANSPORT_POLICY=relay
# ICE_USERNAME=avatar
# ICE_CREDENTIAL=change_me
